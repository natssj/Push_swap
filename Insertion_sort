typedef struct s_stack
{
    int             value;
    struct s_stack  *next;
}   t_stack;

// Mueve el primer elemento de src al inicio de dst
void push(t_stack **src, t_stack **dst)
{
    t_stack *tmp;

    if (!*src)
        return;
    tmp = *src;
    *src = (*src)->next;
    tmp->next = *dst;
    *dst = tmp;
}

// Rota B hacia adelante: el primero pasa al final
void rotate(t_stack **stack)
{
    t_stack *first;
    t_stack *last;

    if (!*stack || !(*stack)->next)
        return;
    first = *stack;
    *stack = (*stack)->next;
    last = *stack;
    while (last->next)
        last = last->next;
    last->next = first;
    first->next = NULL;
}

// Rotación inversa: el último pasa a ser el primero
void reverse_rotate(t_stack **stack)
{
    t_stack *prev;
    t_stack *last;

    if (!*stack || !(*stack)->next)
        return;
    prev = *stack;
    last = *stack;
    while (last->next)
    {
        prev = last;
        last = last->next;
    }
    prev->next = NULL;
    last->next = *stack;
    *stack = last;
}
int find_insertion_position(t_stack *b, int value)
{
    int pos;

    pos = 0;
    while (b && b->value < value)
    {
        b = b->next;
        pos++;
    }
    return (pos);
}
void rotate_to_position(t_stack **b, int position, int size)
{
    if (position <= size - position)
    {
        while (position-- > 0)
            rotate(b);
    }
    else
    {
        while (position++ < size)
            reverse_rotate(b);
    }
}
void insertion_sort(t_stack **a, t_stack **b, int size)
{
    int value;
    int pos;
    int b_size;

    b_size = 0;
    while (*a)
    {
        value = (*a)->value;
        pos = find_insertion_position(*b, value);
        rotate_to_position(b, pos, b_size);
        push(a, b);          // esto imprimiría "pb" en la versión real
        b_size++;
    }
